# application.yml 예시 — 이 파일을 application.yml로 복사해서 값만 채우세요.
#   cp application.yml.example application.yml
# application.yml은 .gitignore 대상(커밋 금지). 비밀값은 여기 말고 application.yml이나 환경변수에만.
# 환경변수로도 넣을 수 있음: SPRING_DATASOURCE_PASSWORD, JWT_SECRET, KIS_APP_KEY ...
# ddl-auto·Flyway 설정은 커밋되는 application.properties에 있음 (그 파일이 우선)

spring:
  application:
    name: budget-dashboard

  datasource:
    url: jdbc:mariadb://localhost:3333/budget_dashboard?characterEncoding=UTF-8&serverTimezone=Asia/Seoul
    username: budget
    password: CHANGE_ME
    driver-class-name: org.mariadb.jdbc.Driver

  jpa:
    show-sql: false
    properties:
      hibernate:
        format_sql: true

logging:
  level:
    root: INFO

server:
  port: 8888
  servlet:
    multipart:
      max-file-size: -1
      max-request-size: -1

# Cloudflare R2 (사진 업로드) — 비워 두면 서버 컴퓨터 로컬 폴더(~/dailo-uploads)에 저장
r2:
  account-id: YOUR_ACCOUNT_ID
  access-key: YOUR_ACCESS_KEY
  secret-key: YOUR_SECRET_KEY
  bucket-name: YOUR_BUCKET_NAME
  public-domain: https://YOUR_PUBLIC_DOMAIN

# JWT 서명 키 — 필수. 없거나 32바이트 미만이면 서버가 안 뜸.  생성: openssl rand -base64 48
jwt:
  secret: CHANGE_ME_TO_RANDOM_STRING
